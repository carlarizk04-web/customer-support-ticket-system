                break;

            case 3:
                viewTicketDetails();
                pauseProgram();
                break;

            case 4:
                searchTickets();
                pauseProgram();
                break;

            case 5:
                updateTicketStatus();
                pauseProgram();
                break;

            case 6:
                changePriority();
                pauseProgram();
                break;

            case 7:
                reassignTicket();
                pauseProgram();
                break;

            case 8:
                deleteTicket();
                pauseProgram();
                break;

            case 9:
                showStatistics();
                pauseProgram();
                break;

            case 0:

                saveTickets();

                cout << "\n========================================\n";
                cout << "Thank you for using the system!\n";
                cout << "Goodbye!\n";
