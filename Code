// ======================================================
// REASSIGN TICKET
// ======================================================

void reassignTicket() {

    int id = getInteger("\nEnter ticket ID: ");

    int index = findTicketIndex(id);

    if (index == -1) {

        cout << "Ticket not found.\n";
        return;
    }

    cout << "\nCurrent agent: "
         << tickets[index].assignedAgent << "\n";

    string newAgent =
        getNonEmptyInput("Enter new agent name: ");

    tickets[index].assignedAgent = newAgent;

    saveTickets();

    cout << "\nTicket reassigned successfully.\n";
}

// ======================================================
// DELETE TICKET
// ======================================================

void deleteTicket() {

    int id = getInteger("\nEnter ticket ID to delete: ");

    int index = findTicketIndex(id);

    if (index == -1) {

        cout << "Ticket not found.\n";
        return;
    }

    cout << "\nTicket found:\n";

    displayTicket(tickets[index]);

    cout << "\nAre you sure you want to delete this ticket?\n";
    cout << "1. Yes\n";
    cout << "2. No\n";

    int choice = getInteger("Choose: ");

    if (choice == 1) {

        tickets.erase(tickets.begin() + index);

        saveTickets();

        cout << "\nTicket deleted successfully.\n";
    }
    else {

        cout << "\nDeletion cancelled.\n";
    }
}

// ======================================================
// SUPPORT STATISTICS
// ======================================================

void showStatistics() {

    int open = 0;
    int inProgress = 0;
    int pending = 0;
    int resolved = 0;
    int closed = 0;

    int low = 0;
    int medium = 0;
    int high = 0;
    int critical = 0;

    for (const Ticket& ticket : tickets) {

        // Status
        if (ticket.status == "Open")
            open++;

        else if (ticket.status == "In Progress")
            inProgress++;

        else if (ticket.status == "Pending Customer")
            pending++;

        else if (ticket.status == "Resolved")
            resolved++;

        else if (ticket.status == "Closed")
            closed++;

        // Priority
        if (ticket.priority == "Low")
            low++;

        else if (ticket.priority == "Medium")
            medium++;

        else if (ticket.priority == "High")
            high++;

        else if (ticket.priority == "Critical")
            critical++;
    }

    cout << "\n========================================\n";
    cout << "           SUPPORT STATISTICS\n";
    cout << "========================================\n";

    cout << "\nTotal Tickets: " << tickets.size() << "\n";

    cout << "\n--- Ticket Status ---\n";

    cout << "Open             : " << open << "\n";
    cout << "In Progress      : " << inProgress << "\n";
    cout << "Pending Customer : " << pending << "\n";
    cout << "Resolved         : " << resolved << "\n";
    cout << "Closed           : " << closed << "\n";

    cout << "\n--- Ticket Priority ---\n";

    cout << "Low              : " << low << "\n";
    cout << "Medium           : " << medium << "\n";
    cout << "High             : " << high << "\n";
    cout << "Critical         : " << critical << "\n";
}

